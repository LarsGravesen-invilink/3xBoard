<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">3xBoard</string>
    <style name="Theme.XBoard" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F5F5F2</item>
    </style>
    <style name="Theme.XBoard.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F5F5F2</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_xboard</item>
        <item name="postSplashScreenTheme">@style/Theme.XBoard</item>
    </style>
</resources>
