<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.XBoard" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#111411</item>
    </style>
    <style name="Theme.XBoard.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#111411</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_xboard</item>
        <item name="postSplashScreenTheme">@style/Theme.XBoard</item>
    </style>
</resources>
