#!/bin/sh
set -eu
ROOT=$(dirname -- "$(readlink -f -- "$0")")
export PYTHONPATH="$ROOT/vendor/usr/lib/python3/dist-packages${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="$ROOT/vendor/usr/lib/$(uname -m)-linux-gnu:$ROOT/vendor/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$ROOT/venv/bin/python" "$@"
